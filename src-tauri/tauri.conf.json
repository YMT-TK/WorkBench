{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBench",
  "version": "0.1.0",
  "identifier": "com.workbench.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkBench",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --no-sandbox"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "YMT-TK",
    "copyright": "Copyright © 2026 YMT-TK",
    "homepage": "https://github.com/YMT-TK/WorkBench",
    "category": "DeveloperTool",
    "shortDescription": "插件化桌面工作台",
    "longDescription": "插件化桌面工作台：数据中心卡片 + 项目管理 + 音频管理，数据本地 SQLite 存储。",
    "licenseFile": "EULA.txt",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "uninstallerHeaderImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "compression": "lzma",
        "startMenuFolder": "WorkBench"
      }
    }
  }
}
